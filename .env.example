# ============================================================
# Copy this file to ".env" and fill in the values you have.
# The app works in DEMO/LOCAL mode with nothing filled in except
# it won't be able to do AI extraction, AI chat, or send real email.
# ============================================================

# ---- OpenAI (required for: smart RFQ field extraction, gap-analysis
#      reasoning, multilingual query bot). Get one at platform.openai.com ----
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ---- Embeddings mode for FAISS vector search ----
# "local"  -> uses a free local model (sentence-transformers), no API key needed
# "openai" -> uses OpenAI embeddings (better quality, costs a bit, needs key above)
EMBEDDINGS_MODE=local

# ---- SMTP email (required only to actually SEND supplier emails) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_NAME=Procurement Team
# For Gmail: create an "App Password" (not your normal password) at
# https://myaccount.google.com/apppasswords
# For Outlook: smtp-mail.outlook.com, port 587

# ---- Storage backend ----
# "local" -> stores files/index on this machine's disk (default, works out of the box)
# "azure" -> uses Azure Blob Storage + Cosmos DB (fill in the block below)
STORAGE_BACKEND=local

# ---- Azure (only needed if STORAGE_BACKEND=azure) ----
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=rfq-documents
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_KEY=
AZURE_COSMOS_DATABASE=quotation_management
AZURE_COSMOS_CONTAINER=quotations

# ---- LlamaParse (only needed if DOC_PARSER_MODE=llamaparse) ----
# Get a key at cloud.llamaindex.ai. Otherwise local parsers (pdfplumber /
# python-docx / openpyxl) are used automatically and work with no key.
LLAMA_CLOUD_API_KEY=
DOC_PARSER_MODE=local
